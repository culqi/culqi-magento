<style>
    #culqi-iframe-overlay {
        display: none;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        background: white;
        z-index: 9999 !important;
        margin: 0 !important;
        padding: 0 !important;
    }
    #culqi-iframe-overlay.active {
        display: block !important;
    }
    #culqi-iframe-overlay .culqi-iframe-close {
        position: absolute;
        top: 15px;
        right: 20px;
        width: 40px;
        height: 40px;
        background: #eb5757;
        border: none;
        border-radius: 4px;
        color: white;
        font-size: 24px;
        font-weight: bold;
        cursor: pointer;
        z-index: 10000;
        line-height: 1;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    #culqi-iframe-overlay .culqi-iframe-close:hover {
        background: #d63031;
    }
    #culqi-iframe-overlay iframe {
        width: 100% !important;
        height: 100% !important;
        border: none !important;
        display: block !important;
    }
    .culqi-configure-btn {
        background: #eb5202;
        color: #ffffff;
        border: none;
        padding: 10px 20px;
        font-size: 14px;
        border-radius: 3px;
        cursor: pointer;
        font-weight: 600;
    }
    .culqi-configure-btn:hover {
        background: #eb5202;
        color: #ffffff;
    }
</style>

<button type="button" class="culqi-configure-btn" onclick="openCulqiIframe()">
    Configurar Culqi
</button>

<div id="culqi-iframe-overlay">
    <button type="button" class="culqi-iframe-close" onclick="closeCulqiIframe()" title="Cerrar">×</button>
    <iframe 
        src="<?php echo $block->escapeUrl($block->getIframeUrl()); ?>" 
        style="width: 100%; height: 100%; border: none;">
    </iframe>
</div>

<script>
    function openCulqiIframe() {
        document.getElementById('culqi-iframe-overlay').classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    
    function closeCulqiIframe() {
        document.getElementById('culqi-iframe-overlay').classList.remove('active');
        document.body.style.overflow = '';
    }
    
    // Close with ESC key
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeCulqiIframe();
        }
    });
</script>
